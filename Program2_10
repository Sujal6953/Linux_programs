#Program6 : Deleting duplicate file
echo "Creating first file..."
cat>file1.txt<<EOF
Hello Linux
Shell Scripting
EOF

echo "Creating second file..."
cat>file2.txt<<EOF
Hello Linux
Shell Scripting
EOF

echo "Comparing two files"
cmp -s file1.txt file2.txt 

if [ $? -eq 0 ]
then 
	echo "Both files are identical."
	rm file2.txt
	echo "file2.txt deleted"
else
	echo "Files are different"
fi

