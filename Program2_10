#Program3 : list of files names with each word occurances
echo "Creating input files..."
cat>file1.txt<<EOF
apple orange mango
EOF

cat>file2.txt<<EOF
apple apple mango banana
EOF

cat>file3.txt<<EOF
orange mango apple apple
EOF

echo "First file"
first=file1.txt
echo "Remaining files"
set -- file2.txt file3.txt
for word in $(cat $first)
do
  echo "Word:$word"
  for file in "$@"
  do
    count=$(grep -ow "$word" "$file" | wc -l)
    echo "$file:$count"
  done
  echo "--------------"
done

#Program4 : lowercase to uppercase
echo "Creating file1.txt..."
cat>file1.txt<<EOF
hello linux
shell scripting
EOF

echo "Creating file2.txt..."
cat>file2.txt<<EOF
welcome to linux
operating system
EOF
echo "Processing those files..."
set -- file1.txt file2.txt
for file in "$@"
do 
	if [ -f "file" ]
	then 
		tr '[:lower:]' '[:upper:]' <"$file"> temp
		mv temp "$file"
		echo "$file converted to uppercase"
	else
		echo "$file does not exists"
	fi
done

